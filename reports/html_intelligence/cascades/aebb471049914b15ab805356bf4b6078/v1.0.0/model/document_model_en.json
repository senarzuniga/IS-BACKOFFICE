              "component_kind": "text",
              "title": "Day 3 · Stress test, quick wins and target architecture",
              "body": "Observe peaks and changeovers; test agreed recovery and manual modes; validate queues and constraints; prioritize immediate actions; close functional requirements, missing data and investment acceptance tests.",
              "items": [],
              "props": {},
              "asset_ids": [],
              "style_tokens": [],
              "evidence_ids": [],
              "knowledge_keys": [],
              "semantic_labels": [],
              "confidence": 1.0
