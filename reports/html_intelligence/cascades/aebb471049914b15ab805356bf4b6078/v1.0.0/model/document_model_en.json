            {
              "id": "b4d9c0cdc7544947a1745654c25b3b03",
              "component_kind": "text",
              "title": "Day 2 · Electrical, PLC, drives and connectivity",
              "body": "Inventory PLC/HMI/VFD/servo assets, versions, networks and protocols; review I/O, handshakes, safety, alarms, histories and data capability; verify interfaces across bundlers, restackers, pallet inserters, strappers, wrappers and conveyors.",
              "items": [],
              "props": {},
              "asset_ids": [],
              "style_tokens": [],
              "evidence_ids": [],
              "knowledge_keys": [],
              "semantic_labels": [],
              "confidence": 1.0
